# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable binary (each teammate installs it with: npx impeccable install)
.claude/skills/impeccable/scripts/bin/

# Kept out on purpose: its own git repository, with real people's CVs in resumes/ (the CV parser needs a local copy)
/backend/resume_parser.py/
# Third-party reports (B Corp, Equidad MX, HRC), 22 MB; the app does not read them
/backend/data/reference/source_docs/
