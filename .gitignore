# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# what employers publish, kept by the server for the public API
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable binary (each teammate installs it with: npx impeccable install)
.claude/skills/impeccable/scripts/bin/

# The CV parser is in backend/resume_parser/. Its test mode saves CVs in resumes/: real people's data, never in git.
/backend/resume_parser/resumes/
# The old local copy of the parser: its own git repository, whose history has a real CV.
/backend/resume_parser.py/
# Third-party reports (B Corp, Equidad MX, HRC), 22 MB; the app does not read them
/backend/data/reference/source_docs/

# Local development tooling and working notes, kept out of the delivered repo
/CLAUDE.md
/AGENTS.md
/.claude/
/.impeccable/
/tasks/
/skills-lock.json
/SPEC-*.md
