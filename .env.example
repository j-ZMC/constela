# Optional settings. The app needs no key. Copy this file to .env.local to change them (never push it to GitHub).
# Only for backend/company_sizes.py, run by hand. The app itself does not use OpenAI.
OPENAI_API_KEY=
# Optional. Set to a Python interpreter with backend/requirements.txt installed.
PYTHON_EXECUTABLE=
# Interview practice runs on Ollama on this computer. Both are optional.
# OLLAMA_URL defaults to http://127.0.0.1:11434 and OLLAMA_MODEL to llama3.1:8b.
OLLAMA_URL=
OLLAMA_MODEL=
# Optional. The Whisper model for Talk mode; defaults to small.en.
WHISPER_MODEL=
# Optional. The AI's voice (Kokoro): defaults to af_heart and 0.95.
KOKORO_VOICE=
KOKORO_SPEED=
# Optional. "on" lets `npm start` receive published job posts for the public API. `npm run dev` always can.
# Leave it off on any public server: there are no accounts yet, so nothing proves who is writing.
PUBLIC_API_WRITES=
# Optional. The seal's Ed25519 private key (PKCS#8 PEM; write new lines as \n). Without it, one is made in .data/.
# Set it on a server, so seals stay checkable after a new deploy.
SEAL_SIGNING_KEY=
