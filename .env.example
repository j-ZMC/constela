# Copy this file to .env.local and add your real key (never push it to GitHub)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b; change it if Groq retires that model.
GROQ_MODEL=
# Used to embed job-search phrases; keep the real key in .env.local.
OPENAI_API_KEY=
# Optional. Set to a Python interpreter with backend/requirements.txt installed.
PYTHON_EXECUTABLE=
# Interview practice runs on Ollama on this computer. Both are optional.
# OLLAMA_URL defaults to http://127.0.0.1:11434 and OLLAMA_MODEL to llama3.1:8b.
OLLAMA_URL=
OLLAMA_MODEL=
# Optional. The Whisper model for Talk mode; defaults to small.en.
WHISPER_MODEL=
# Optional. The AI's voice (Kokoro): defaults to af_heart and 0.95.
KOKORO_VOICE=
KOKORO_SPEED=
